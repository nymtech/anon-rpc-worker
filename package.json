{
  "name": "@nymproject/anon-rpc-worker",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "description": "anon-rpc conforming worker (SPEC §3.2) that anonymises fetch/RPC over the Nym mixnet via @nymproject/mix-fetch.",
  "files": ["dist", "LICENSE", "NOTICE"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node build-test.mjs && node --test test/*.test.mjs",
    "test:e2e": "node test/e2e/run-e2e.mjs",
    "test:onchain": "node test/e2e/run-onchain.mjs",
    "verify-kps": "node verify-kps.mjs",
    "prepublishOnly": "npm run build"
  },
  "repository": { "type": "git", "url": "git+https://github.com/nymtech/anon-rpc-worker.git" },
  "homepage": "https://github.com/nymtech/anon-rpc-worker",
  "bugs": { "url": "https://github.com/nymtech/anon-rpc-worker/issues" },
  "dependencies": {
    "@nymproject/mix-fetch": "3.0.0",
    "fake-indexeddb": "^6.2.5"
  },
  "devDependencies": {
    "@anon-rpc/browser-harness": "^0.1.0",
    "@kpstreams/quic-client": "^0.2.1",
    "@noble/hashes": "^2.2.0",
    "esbuild": "^0.24.0",
    "playwright": "^1.61.1",
    "typescript": "^5.6.0"
  }
}
